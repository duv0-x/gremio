# Copia a /gremio/gremio.env (permisos 600, dueño root). Lo lee gremio.service.
GREMIO_DATA_DIR=/gremio/data
GREMIO_ADDR=127.0.0.1:8081
# Permanentes una vez que la instancia federa (ADR-001).
GREMIO_HOST=https://work.example.org
GREMIO_ACCOUNT_DOMAIN=example.org
# Login del panel (ADR-009): SMTP con TLS. La clave va en /gremio/secrets.env (600, root):
#   GREMIO_SMTP_PASSWORD=…
# GREMIO_SMTP_HOST=smtp.ejemplo.org
# GREMIO_SMTP_PORT=465
# GREMIO_SMTP_USERNAME=usuario
# GREMIO_SMTP_FROM=Gremio <gremio@ejemplo.org>
