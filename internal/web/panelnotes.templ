package web

import (
	"strconv"
	"time"
)

templ PanelNotesPage(p panelNotes) {
	@panelLayout(p.Version, "Notas") {
		@pluginsHeader("/panel", "Panel", "Notas")
		<p class="-mt-3 text-muted">Lo que publiques aquí sale como { p.Handle } a tus seguidores del fediverso (Mastodon y demás) y, si lo activaste en Básico y contacto, se ve en la pestaña Notas de tu perfil.</p>
		if p.Notice != "" {
			<p role="status" tabindex="-1" autofocus class="rounded-md border border-success p-4 text-sm text-ink">{ p.Notice }</p>
		}
		if p.Error != "" {
			<p role="alert" tabindex="-1" autofocus class="rounded-md border border-danger p-4 text-sm text-ink">{ p.Error }</p>
		}
		<form method="post" action="/panel/notas" class={ card, "flex flex-col gap-4" }>
			<div class="flex flex-col gap-1.5">
				<label for="texto" class={ labelCls }>Nueva nota</label>
				<textarea id="texto" name="texto" rows="5" required maxlength={ strconv.Itoa(maxNoteLen) } class={ inputCls, "py-2 leading-relaxed" } aria-describedby="texto-ayuda">{ p.Text }</textarea>
				<p id="texto-ayuda" class={ hintCls }>Texto plano, hasta { strconv.Itoa(maxNoteLen) } caracteres. Una vez publicada no se puede editar ni borrar desde Gremio.</p>
			</div>
			<button type="submit" class={ btnPrimary, "sm:self-start" }>Publicar</button>
		</form>
		<section class="flex flex-col gap-3" aria-labelledby="recientes">
			<h2 id="recientes" class="font-display text-xl font-bold">Recientes</h2>
			if len(p.Notes) == 0 {
				<p class="text-sm text-muted">Todavía no has publicado notas.</p>
			}
			for _, n := range p.Notes {
				<article class={ card }>
					<p class="leading-relaxed whitespace-pre-line text-ink">{ n.Text }</p>
					<p class="mt-3 font-mono text-[13px] text-faint"><time datetime={ n.Published.Format(time.RFC3339) }>{ n.Published.Format("2006-01-02 15:04") } UTC</time></p>
				</article>
			}
		</section>
	}
}
