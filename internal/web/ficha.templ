package web

import (
	"time"

	"github.com/duv0-x/gremio/internal/icons"
	"github.com/duv0-x/gremio/internal/profile"
)

// Ficha de jugador (ADR-010, DESIGN.md: pantallas "Ficha de jugador").
const (
	panel    = "rounded-lg border border-line bg-surface p-5 sm:p-8"
	h2Ficha  = "font-display text-xl font-bold uppercase tracking-[0.01em]"
	statTile = "rounded-lg border border-line bg-surface p-5"
	btnSec   = "inline-flex min-h-11 items-center justify-center rounded-md border-[1.5px] border-control px-[18px] text-[15px] font-semibold text-ink no-underline hover:bg-surface-2 hover:text-ink"
)

templ ficha(p Page) {
	<div id="ficha" class="mx-auto flex max-w-[1200px] flex-col gap-6 px-4 pt-8 pb-8 sm:px-6 sm:pt-12">
		<div class="grid gap-6 lg:grid-cols-[5fr_7fr]">
			@fichaHero(p)
			@fichaRadar(topAttributes(p.Resume.Gremio.Attributes, radarSlots), len(p.Resume.Gremio.Attributes))
		</div>
		@fichaAttributes(p)
	</div>
	for _, a := range p.Resume.Gremio.Attributes {
		@attributeDetail(p, a)
	}
}

// actions es la barra de acciones, siempre visible en todas las pestañas: abajo a lo ancho en móvil y flotando
// abajo a la derecha en pantallas anchas.
templ actions(p Page) {
	if p.HasCV || p.WhatsApp() != "" {
		<nav aria-label="Acciones" class="fixed inset-x-0 bottom-0 z-20 flex gap-3 border-t border-line bg-bg/95 px-4 py-3 sm:inset-x-auto sm:right-6 sm:bottom-6 sm:rounded-lg sm:border sm:p-3 sm:shadow-[0_8px_24px_rgb(22_24_27/0.12)]">
			if p.HasCV {
				<a class={ btnPrimary, "flex-1 gap-2 sm:flex-none" } href={ templ.SafeURL(p.cvPDFPath()) } download>
					@icon("download")
					Descargar CV (PDF)
				</a>
			}
			if p.WhatsApp() != "" {
				// El enlace pasa por /@usuario/whatsapp para que el número no quede en el HTML.
				<a class={ btnSec, "flex-1 gap-2 sm:flex-none" } href={ templ.SafeURL(p.whatsappPath()) } rel="nofollow noopener" target="_blank">
					@icon("message-circle")
					WhatsApp
				</a>
			}
		</nav>
	}
}

// icon es un ícono de Lucide de 20 px, decorativo.
templ icon(name string) {
	<svg viewBox="0 0 24 24" class="size-5 shrink-0" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
		@templ.Raw(icons.Inner(name))
	</svg>
}

templ fichaHero(p Page) {
	<section class={ panel, "flex flex-col gap-6" } aria-labelledby="nombre">
		<div class="flex items-start gap-5">
			<span class="tip shrink-0" data-tip={ ovrTitle } tabindex="0">
				<svg viewBox="0 0 120 120" class="size-24 sm:size-28" role="img" aria-label={ "Índice general " + itoa(p.Overall()) + ". " + ovrTitle }>
					<polygon points={ hexagon(60, 60, 54) } class="fill-accent-soft stroke-accent" stroke-width="3"></polygon>
					<text x="60" y="40" text-anchor="middle" class="fill-accent font-mono text-[13px] font-medium">OVR</text>
					<text x="60" y="80" text-anchor="middle" class="fill-ink font-display text-[44px] font-bold">{ itoa(p.Overall()) }</text>
				</svg>
			</span>
			<div class="min-w-0 flex-1">
				if v, ok := p.Selected(); ok {
					<p class={ eyebrow }>Posición</p>
					<p class="mt-1 flex flex-wrap items-baseline gap-x-2 font-display">
						@sigla(viewCode(v), positionTitle(v), "text-3xl font-bold", true)
						if v.Level != "" {
							@sigla(levelShort(v), levelLong(v), "text-lg font-semibold text-muted", true)
						}
						for i, o := range p.Resume.Gremio.Views {
							if i != p.View {
								<span class="text-sm text-faint">· @sigla(viewCode(o), positionTitle(o), "", true)</span>
							}
						}
					</p>
					<p class="mt-1 font-mono text-[13px] text-accent">
						{ positionName(v) }
						if v.Level != "" {
							· { levelLong(v) }
						}
					</p>
				}
			</div>
			<span aria-hidden="true" class="flex size-14 shrink-0 items-center justify-center rounded-lg border border-line bg-surface-2 font-display text-xl font-bold text-accent">{ initials(p.Resume.Basics.Name) }</span>
		</div>
		<div class="border-t border-line pt-6">
			<h1 id="nombre" class="font-display text-[34px] leading-[1.05] font-bold tracking-[-0.01em] uppercase sm:text-[44px]">{ p.Resume.Basics.Name }</h1>
			<p class="mt-2 text-muted">{ p.Resume.Basics.Label }</p>
			if loc, tz := p.Location(), p.Resume.Gremio.Timezone; loc != "" || tz != "" {
				<p class="mt-1 font-mono text-sm text-faint">
					{ loc }
					if tz, tip := p.TimeZone(time.Now()); tz != "" {
						if loc != "" {
							·
						}
						@sigla(tz, tip, "", true)
					}
				</p>
			}
		</div>
		if len(p.Resume.Gremio.Views) > 1 {
			<div>
				<p class={ eyebrow } id="roles">@sigla("OVR", ovrTitle, "", true) por rol</p>
				<ul class="mt-3 flex flex-wrap gap-3" aria-labelledby="roles">
					for i, v := range p.Resume.Gremio.Views {
						<li class="shrink-0">
							if i == p.View {
								<a href={ templ.SafeURL(p.viewPath(i)) } aria-current="page" class="flex min-h-11 min-w-[84px] flex-col items-center rounded-md bg-accent px-3 py-2 text-on-accent no-underline hover:text-on-accent">
									@roleChip(p, v)
								</a>
							} else {
								<a href={ templ.SafeURL(p.viewPath(i)) } class="flex min-h-11 min-w-[84px] flex-col items-center rounded-md border border-line px-3 py-2 text-ink no-underline hover:bg-surface-2 hover:text-ink">
									@roleChip(p, v)
								</a>
							}
						</li>
					}
				</ul>
			</div>
		}
		if len(p.Resume.Gremio.Traits) > 0 {
			<div>
				<p class={ eyebrow } id="rasgos">Rasgos</p>
				<ul class="mt-3 flex flex-wrap gap-3" aria-labelledby="rasgos">
					for _, t := range p.Resume.Gremio.Traits {
						<li>
							@traitBadge(t)
						</li>
					}
				</ul>
			</div>
		}
	</section>
}

templ roleChip(p Page, v profile.View) {
	@sigla(viewCode(v), positionTitle(v), "font-mono text-[12px] uppercase", false)
	<span class="font-display text-2xl font-bold">{ itoa(p.Resume.Overall(v)) }</span>
}

templ fichaRadar(attrs []profile.Attribute, total int) {
	<section class={ panel } aria-labelledby="radar-titulo">
		<h2 id="radar-titulo" class={ h2Ficha }>Radar</h2>
		<p class="mt-1 font-mono text-[13px] text-faint">
			Puntajes de 0 a 99, autodeclarados
			if total > len(attrs) {
				· los { itoa(len(attrs)) } mejores de { itoa(total) }
			}
		</p>
		<svg viewBox="-40 0 420 340" class="mx-auto mt-4 w-full max-w-[460px]" role="img" aria-labelledby="radar-desc">
			<desc id="radar-desc">
				for _, a := range attrs {
					{ a.Name }: { itoa(a.Score()) }.
				}
			</desc>
			for _, f := range []float64{0.25, 0.5, 0.75, 1} {
				<polygon points={ radarRing(len(attrs), f) } class="fill-none stroke-line" stroke-width="1"></polygon>
			}
			for i := range attrs {
				{{ x, y := radarAxis(i, len(attrs)) }}
				<line x1="170" y1="170" x2={ x } y2={ y } class="stroke-line" stroke-width="1"></line>
			}
			<polygon points={ radarShape(attrs) } class="fill-accent/25 stroke-accent" stroke-width="2.5" stroke-linejoin="round"></polygon>
			for _, l := range radarLabels(attrs) {
				<text x={ l.X } y={ l.Y } text-anchor={ l.Anchor } class="font-mono text-[14px]" aria-hidden="true">
					<tspan class="fill-muted">{ l.Code }</tspan><tspan dx="6" class={ "font-semibold", fillFor(l.Score) }>{ itoa(l.Score) }</tspan>
				</text>
			}
		</svg>
		<dl class="mt-4 grid grid-cols-2 gap-x-4 gap-y-1 text-[13px] sm:grid-cols-3">
			for _, a := range attrs {
				<div class="flex gap-2">
					<dt class="font-mono text-accent">{ a.Code }</dt>
					<dd class="text-muted">{ a.Name }</dd>
				</div>
			}
		</dl>
	</section>
}

templ fichaAttributes(p Page) {
	<section id="atributos" class={ panel } aria-labelledby="atributos-titulo" data-cinta>
		<div class="flex flex-wrap items-center justify-between gap-2">
			<div>
				<h2 id="atributos-titulo" class={ h2Ficha }>Atributos</h2>
				<p class="mt-1 font-mono text-[13px] text-faint">Desliza para ver más · toca uno para ver el detalle</p>
			</div>
			@cintaArrows("Atributos anteriores", "Atributos siguientes")
		</div>
		// Cinta horizontal con scroll-snap; tabindex para poder deslizarla con el teclado.
		<ul data-cinta-track tabindex="0" aria-label="Atributos" class="mt-6 -mx-1 flex snap-x snap-mandatory gap-4 overflow-x-auto scroll-px-1 px-1 pb-4">
			for _, a := range p.Resume.Gremio.Attributes {
				<li class="w-[200px] shrink-0 snap-start sm:w-[220px]">
					<a href={ templ.SafeURL("#" + attrAnchor(a.Code)) } class="flex h-full flex-col rounded-md border border-line bg-surface-2/40 p-4 text-ink no-underline hover:border-accent hover:text-ink">
						<span class="flex items-start justify-between gap-2">
							<span>
								@sigla(a.Code, a.Name, "block w-fit font-mono text-[13px] text-accent", false)
								<span class="mt-0.5 block text-sm leading-snug font-semibold">{ a.Name }</span>
							</span>
							<span class={ "font-display text-[32px] leading-none font-bold", scoreClass(a.Score()) }>{ itoa(a.Score()) }</span>
						</span>
						<span class="mt-4 flex flex-col gap-3 border-t border-line pt-4">
							for _, s := range a.Subs {
								@subBar(s)
							}
						</span>
						<span class="mt-auto flex items-center justify-between pt-4 font-mono text-[13px] text-faint">Explorar <span aria-hidden="true">›</span></span>
					</a>
				</li>
			}
		</ul>
	</section>
}

templ subBar(s profile.Sub) {
	<span class="block">
		<span class="flex items-baseline justify-between gap-2 text-[13px]">
			<span class="truncate">
				{ s.Name }
				if s.Learning {
					<span class="ml-1 rounded-sm bg-surface-2 px-1 font-mono text-[11px] text-muted">aprendiendo</span>
				}
			</span>
			<span class="font-mono font-semibold">{ itoa(s.Score) }</span>
		</span>
		<svg viewBox="0 0 100 4" preserveAspectRatio="none" class="mt-1.5 block h-1 w-full" aria-hidden="true">
			<rect width="100" height="4" rx="2" class="fill-line"></rect>
			if s.Learning {
				<rect x="0.5" y="0.5" width={ itoa(max(s.Score-1, 1)) } height="3" rx="1.5" class={ barClass(s) } stroke-dasharray="3 2" vector-effect="non-scaling-stroke"></rect>
			} else {
				<rect width={ itoa(s.Score) } height="4" rx="2" class={ barClass(s) }></rect>
			}
		</svg>
	</span>
}

// drawer es el panel lateral de detalle: se abre con :target (#id) y funciona sin JavaScript.
// header va arriba junto al botón de cerrar; el título del header debe llevar id={ id + "-titulo" }.
templ drawer(id, closeHref string, header templ.Component) {
	<section id={ id } role="dialog" aria-labelledby={ id + "-titulo" } class="fixed inset-0 z-30 hidden justify-end target:flex">
		<a href={ templ.SafeURL(closeHref) } class="absolute inset-0 bg-black/60" aria-label="Cerrar el detalle" tabindex="-1"></a>
		<div class="relative flex h-full w-full max-w-[560px] flex-col overflow-y-auto border-l border-line bg-bg">
			<header class="flex items-start justify-between gap-4 border-b border-line p-6">
				<div>
					@header
				</div>
				<a href={ templ.SafeURL(closeHref) } class="flex size-11 shrink-0 items-center justify-center rounded-md border border-line text-xl text-ink no-underline hover:bg-surface-2 hover:text-ink" aria-label="Cerrar">×</a>
			</header>
			<div class="flex flex-col gap-8 p-6">
				{ children... }
			</div>
		</div>
	</section>
}

templ attributeHeader(a profile.Attribute) {
	<p class="flex items-center gap-3">
		@sigla(a.Code, a.Name, "rounded-sm border border-accent px-2 py-0.5 font-mono text-[13px] text-accent", true)
		<span class={ eyebrow }>Atributo</span>
	</p>
	<h2 id={ attrAnchor(a.Code) + "-titulo" } class="mt-2 font-display text-2xl font-bold">{ a.Name }</h2>
}

templ attributeDetail(p Page, a profile.Attribute) {
	@drawer(attrAnchor(a.Code), "#atributos-titulo", attributeHeader(a)) {
		<div class="flex items-end gap-4 rounded-lg border border-line bg-surface p-5">
			<p class={ "font-display text-[56px] leading-none font-bold", scoreClass(a.Score()) }>{ itoa(a.Score()) }</p>
			<p class="pb-1 text-sm text-muted">
				Autodeclarado
				if n := len(a.Highlights); n > 0 {
					· respaldado por { itoa(n) } { plural(n, "logro", "logros") }
				}
			</p>
		</div>
		<div>
			<h3 class={ eyebrow }>Sub-atributos</h3>
			<div class="mt-3 flex flex-col gap-4 rounded-lg border border-line bg-surface p-5">
				for _, s := range a.Subs {
					@subBar(s)
				}
			</div>
		</div>
		if kws := attrKeywords(p.Resume, a); len(kws) > 0 {
			<div>
				<h3 class={ eyebrow }>Tecnologías</h3>
				<ul class="mt-3 flex flex-wrap gap-2">
					for _, k := range kws {
						<li class="rounded-full border border-line px-3 py-1 text-sm">{ k }</li>
					}
				</ul>
			</div>
		}
		if ws := attrWorks(p.Resume, a); len(ws) > 0 {
			<div>
				<h3 class={ eyebrow }>Dónde lo usó</h3>
				<ul class="mt-3 flex flex-col divide-y divide-line rounded-lg border border-line bg-surface">
					for _, w := range ws {
						<li class="flex flex-wrap items-baseline justify-between gap-2 p-4">
							<span class="font-semibold">{ w.Name }</span>
							<span class="font-mono text-[13px] text-muted">{ dateRange(w.StartDate, w.EndDate) }</span>
						</li>
					}
				</ul>
			</div>
		}
		if hs := attrHighlights(p.Resume, a); len(hs) > 0 {
			<div>
				<h3 class={ eyebrow }>Evidencia</h3>
				<ul class="mt-3 flex flex-col gap-3">
					for _, h := range hs {
						<li class="rounded-lg border border-line bg-surface p-4">
							<p class="font-mono text-[12px] text-faint uppercase">{ h.Work }</p>
							<p class="mt-1 leading-relaxed">{ h.Text }</p>
							for i, e := range h.Evidence {
								<a class="mt-2 inline-flex min-h-11 items-center font-mono text-[13px]" href={ templ.SafeURL(e) } rel="noopener">ver evidencia{ evidenceSuffix(i, len(h.Evidence)) } ↗</a>
							}
						</li>
					}
				</ul>
			</div>
		}
		if ws := weightsFor(p.Resume, a.Code); len(ws) > 0 {
			<div>
				<h3 class={ eyebrow }>Peso en cada rol</h3>
				<ul class="mt-3 flex flex-wrap gap-2">
					for _, w := range ws {
						<li class={ dataChip }>@sigla(w.Code, w.Name, "", true) ×{ w.Weight }</li>
					}
				</ul>
			</div>
		}
	}
}

// traitBadge es la insignia de un rasgo, estilo emblema plano (aprobado en Stitch): hexágono oscuro con borde del
// color del rasgo y su ícono de Lucide (o las iniciales). El nombre y la descripción van en el tooltip.
templ traitBadge(t profile.Trait) {
	<span class="tip tip-start inline-flex" data-tip={ traitTip(t) } tabindex="0">
		<svg viewBox="0 0 120 120" class={ "size-14", "badge-" + traitColor(t) } aria-hidden="true">
			<polygon points={ hexagon(60, 60, 55) } class="badge-stroke fill-surface-2" stroke-width="6" stroke-linejoin="round"></polygon>
			if icon := traitIcon(t); icon != "" {
				<g transform="translate(34 34) scale(2.17)" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="badge-stroke">
					@templ.Raw(icon)
				</g>
			} else {
				<text x="60" y="72" text-anchor="middle" class="badge-text font-display text-[32px] font-bold">{ traitInitials(t.Name) }</text>
			}
		</svg>
		<span class="sr-only">{ traitTip(t) }</span>
	</span>
}

// sigla muestra una abreviatura con su significado en un tooltip CSS inmediato (el title nativo tarda o no aparece,
// y no existe en pantallas táctiles). Dentro de un enlace no lleva tabindex, para no anidar elementos enfocables.
templ sigla(code, tip, class string, focusable bool) {
	<abbr
		class={ "tip", class }
		data-tip={ tip }
		if focusable {
			tabindex="0"
		}
	>{ code }<span class="sr-only">{ " (" + tip + ")" }</span></abbr>
}

// cintaArrows son las flechas de una cinta [data-cinta]. Aparecen solo con JavaScript (static/cinta.js)
// y en pantallas anchas; en móvil la cinta se desliza con el dedo.
templ cintaArrows(prev, next string) {
	<div class="hidden gap-2 sm:flex">
		<button type="button" data-cinta-dir="-1" hidden aria-label={ prev } class="size-11 rounded-md border border-line text-xl text-ink hover:bg-surface-2">‹</button>
		<button type="button" data-cinta-dir="1" hidden aria-label={ next } class="size-11 rounded-md border border-line text-xl text-ink hover:bg-surface-2">›</button>
	</div>
}
