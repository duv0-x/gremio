package web

import (
	"math"
	"strconv"

	"github.com/duv0-x/gremio/internal/dojo"
	"github.com/duv0-x/gremio/internal/dojo/retos"
)

// Páginas del dojo: el panel (catálogo, reto, ejecución, retirar) y las públicas (reto y ejecución publicada).
templ DojoPage(p dojoPage) {
	@panelLayout(p.Version, "Dojo") {
		@pluginsHeader("/panel", "Panel", "Dojo")
		<p class="-mt-3 text-muted">Retos con checks que cualquiera puede volver a correr. Lo que terminas y publicas entra al libro del dojo y suma Entrenamiento en las habilidades del reto. Mide resultados entregados.</p>
		@dojoCapNotice()
		<section aria-labelledby="mis-ejecuciones" class="flex flex-col gap-4">
			<h2 id="mis-ejecuciones" class="font-display text-xl font-bold">Mis ejecuciones</h2>
			if len(p.Executions) == 0 {
				<p class="rounded-md border-[1.5px] border-dashed border-control p-5 text-sm text-muted">Todavía no tomaste ningún reto. Elige uno del catálogo.</p>
			} else {
				<ul class="flex flex-col gap-3">
					for _, e := range p.Executions {
						<li>
							<a href={ templ.SafeURL("/panel/dojo/ejecuciones/" + e.ID) } class="flex flex-wrap items-center justify-between gap-3 rounded-md border border-line bg-surface p-4 text-ink no-underline hover:border-accent hover:text-ink">
								<span class="min-w-0">
									<span class="block font-semibold">{ e.Snapshot.Title }</span>
									<span class={ hintCls }>Empezada el { e.StartedAt.Format("2006-01-02") } · v{ itoa(e.Version) }</span>
								</span>
								<span class="flex flex-wrap gap-1.5">
									<span class={ dataChip }>{ statusLabel(e) }</span>
									if e.Published() {
										<span class={ dataChip }>Pública</span>
									}
								</span>
							</a>
						</li>
					}
				</ul>
			}
		</section>
		<section aria-labelledby="catalogo" class="flex flex-col gap-4">
			<h2 id="catalogo" class="font-display text-xl font-bold">Catálogo</h2>
			<ul class="flex flex-col gap-3">
				for _, it := range p.Catalog {
					<li>
						<a href={ templ.SafeURL("/panel/dojo/catalogo/" + it.Slug) } class="flex flex-col gap-2 rounded-md border border-line bg-surface p-4 text-ink no-underline hover:border-accent hover:text-ink">
							<span class="flex flex-wrap items-center justify-between gap-2">
								<span class="font-mono text-[13px] text-muted">{ skillNames(it.Challenge.Skills) }</span>
								<span class={ dataChip }>{ it.Challenge.Level.String() }</span>
							</span>
							<span class="font-display text-lg font-bold">{ it.Challenge.Title }</span>
							<span class="text-sm text-muted">{ it.Challenge.Pitch }</span>
							<span class={ hintCls }>{ reviewLabel(it.Challenge) }</span>
						</a>
					</li>
				}
			</ul>
			<p class={ hintCls }>Los retos del catálogo entran por PR al repo de Gremio y los revisa alguien distinto del autor. <a href={ templ.SafeURL(Page{Version: p.Version}.SourceURL() + "/blob/main/internal/dojo/retos/catalog/README.md") }>Cómo proponer uno</a>.</p>
		</section>
	}
}

// dojoCapNotice explica los topes de confianza (ADR-013 §4) con el estado real del catálogo.
templ dojoCapNotice() {
	<div role="note" class="rounded-md border border-line bg-surface-2 p-4 text-sm text-ink">
		if !retos.AnyReviewed() {
			<p><strong>Hoy el máximo es 60.</strong> Ningún reto del catálogo está revisado todavía, así que todos cuentan como práctica propia (N2 como máximo). Un reto revisado del catálogo llega hasta N3 (80); verificado por terceros, hasta N4 (99).</p>
		} else {
			<p>Un reto revisado del catálogo llega hasta N3 (80). Un reto en revisión, propio o generado por IA cuenta como práctica propia: N2 (60) como máximo. Verificado por terceros llega hasta N4 (99).</p>
		}
	</div>
}

templ DojoChallengePage(p challengePage) {
	@panelLayout(p.Version, p.Challenge.Title) {
		@pluginsHeader("/panel/dojo", "Dojo", p.Challenge.Title)
		@challengeBody(p.Challenge)
		@panelSection("Cuánto sumaría") {
			<p class="text-sm text-muted">Si lo terminas hoy con la verificación aprobada, cuenta como <strong>{ trustLabel(p.Trust) }</strong>.</p>
			@outcomes(p.Outcomes)
		}
		<form method="post" action={ templ.SafeURL("/panel/dojo/catalogo/" + p.Slug + "/tomar") } class="flex flex-col gap-2">
			<button type="submit" class={ btnPrimary, "sm:self-start" }>Tomar este reto</button>
			<p class={ hintCls }>Se copia la versión { itoa(p.Challenge.Version) } del enunciado. La ejecución es privada hasta que la publiques.</p>
		</form>
	}
}

templ DojoExecutionPage(p executionPage) {
	@panelLayout(p.Version, p.Execution.Snapshot.Title) {
		@pluginsHeader("/panel/dojo", "Dojo", p.Execution.Snapshot.Title)
		<p class="-mt-3 flex flex-wrap gap-1.5">
			<span class={ dataChip }>{ statusLabel(p.Execution) }</span>
			if p.Execution.Published() {
				<span class={ dataChip }>Pública</span>
			} else if p.Execution.Retired() {
				<span class={ dataChip }>Retirada</span>
			} else {
				<span class={ dataChip }>Privada</span>
			}
			<span class={ dataChip }>v{ itoa(p.Execution.Version) }</span>
		</p>
		if p.Notice != "" {
			<p role="status" tabindex="-1" autofocus class="rounded-md border border-success p-4 text-sm text-ink">{ p.Notice }</p>
		}
		if p.Error != "" {
			<p role="alert" tabindex="-1" autofocus class="rounded-md border border-danger p-4 text-sm text-ink">No se pudo: { p.Error }</p>
		}
		if p.Execution.Open() {
			<form method="post" action={ templ.SafeURL(execAction(p.Execution, "entrega")) } class={ card, "flex flex-col gap-4" }>
				<h2 class="font-display text-xl font-bold">Entrega</h2>
				@textField("Repositorio", "repo", p.Execution.Delivery.Repo, "URL https de github.com, codeberg.org o gitlab.com. Tiene que ser público.")
				@textField("Commit", "commit", p.Execution.Delivery.Commit, "El SHA completo (40 caracteres). Los checks corren contra ese commit, así cualquiera puede repetirlos.")
				@textField("Demo", "demo", p.Execution.Delivery.Demo, "Opcional: URL https de la demo o de un video.")
				@textField("Informe", "report", p.Execution.Delivery.Report, "Opcional: URL https del informe de decisiones.")
				@textArea("Notas privadas", "notes", p.Execution.Delivery.Notes, "Solo las ves tú.", 3)
				<button type="submit" class={ btnSec, "sm:self-start" }>Guardar entrega</button>
			</form>
		}
		<section id="verificacion" class={ card, "flex flex-col gap-4" } aria-labelledby="verificacion-titulo">
			<h2 id="verificacion-titulo" class="font-display text-xl font-bold">Verificación</h2>
			@verification(p.Execution)
			if p.Execution.Open() && p.Execution.Delivery.Repo != "" {
				<form method="post" action={ templ.SafeURL(execAction(p.Execution, "verificar")) }>
					<button type="submit" class={ btnSec }>Correr los checks</button>
				</form>
			}
		</section>
		if len(p.Outcomes) > 0 {
			@panelSection("Cuánto sumaría") {
				<p class="text-sm text-muted">Con la verificación aprobada esta ejecución cuenta como <strong>{ trustLabel(p.Trust) }</strong>.</p>
				@outcomes(p.Outcomes)
			}
		}
		@panelSection("Acciones") {
			<div class="flex flex-col gap-3 sm:flex-row sm:flex-wrap">
				if p.Execution.Open() {
					<form method="post" action={ templ.SafeURL(execAction(p.Execution, "terminar")) }>
						<button type="submit" class={ btnPrimary, "w-full" }>Terminar</button>
					</form>
				}
				if p.Execution.PublishedAt.IsZero() && p.Execution.Status != retos.StatusAbandoned {
					<form method="post" action={ templ.SafeURL(execAction(p.Execution, "publicar")) }>
						<button type="submit" class={ btnSec, "w-full" }>Publicar</button>
					</form>
				}
				if p.Execution.Published() {
					<a class={ btnSec } href={ templ.SafeURL(p.Public) }>Ver la página pública</a>
					<a class={ btnSec } href={ templ.SafeURL(execAction(p.Execution, "retirar")) }>Retirar</a>
				}
				if p.Execution.Open() {
					<form method="post" action={ templ.SafeURL(execAction(p.Execution, "abandonar")) }>
						<button type="submit" class={ btnSec, "w-full" }>Abandonar</button>
					</form>
				}
			</div>
			<p class={ hintCls }>Terminar exige que pasen todos los checks. Publicar la muestra en tu perfil y la agrega al libro con su fecha de inicio; si está terminada, también como completada.</p>
		}
		<details class={ card }>
			<summary class="min-h-11 cursor-pointer font-display text-xl font-bold">Enunciado</summary>
			<div class="mt-4 flex flex-col gap-6">
				@challengeBody(p.Execution.Snapshot)
			</div>
		</details>
	}
}

templ DojoRetirePage(version string, e retos.Execution) {
	@panelLayout(version, "Retirar "+e.Snapshot.Title) {
		@pluginsHeader("/panel/dojo/ejecuciones/"+e.ID, e.Snapshot.Title, "Retirar la ejecución")
		<form method="post" action={ templ.SafeURL(execAction(e, "retirar")) } class={ card, "flex flex-col gap-4" }>
			<p class="text-muted">Su página pública deja de mostrarse y sus eventos del libro quedan como tombstone, con el reto, la fecha y el hash. Retirar solo puede bajar tu Entrenamiento, y <strong>este reto no vuelve a sumar</strong> aunque lo hagas de nuevo.</p>
			<div class="flex flex-col gap-3 sm:flex-row">
				<button type="submit" class={ btnDanger }>Retirar</button>
				<a class={ btnSec } href={ templ.SafeURL("/panel/dojo/ejecuciones/" + e.ID) }>Cancelar</a>
			</div>
		</form>
	}
}

templ outcomes(list []dojo.Outcome) {
	<ul class="flex flex-col gap-2">
		for _, o := range list {
			<li class="flex flex-col gap-0.5 rounded-md border border-line p-3 text-sm">
				<span class="font-semibold">{ skillName(o.Skill) }</span>
				if o.Reason == "" {
					<span>De { shown(o.Before) } a { shown(o.After) } (+{ shown(o.After - o.Before) })</span>
				} else {
					<span class="text-muted">No suma: { o.Reason }.</span>
				}
			</li>
		}
	</ul>
}

// verification muestra la última corrida de los checks: contra qué commit, cuándo y qué dio cada uno.
templ verification(e retos.Execution) {
	if v := e.Verification; v == nil {
		<p class="text-sm text-muted">Sin verificar. Guarda la entrega y corre los checks: sin verificación aprobada no hay ganancia.</p>
	} else {
		<p class="text-sm">
			if v.Passed {
				<strong class="text-success">Pasaron todos los checks.</strong>
			} else {
				<strong class="text-danger">Hay checks que no pasaron.</strong>
			}
			Corridos el { v.At.Format("2006-01-02 15:04") } UTC contra <span class="font-mono break-all">{ v.Commit }</span>.
		</p>
		<div class="overflow-x-auto">
			<table class="w-full min-w-[480px] border-collapse text-sm">
				<thead>
					<tr class="text-left">
						<th scope="col" class="py-2 pr-3 font-semibold">Check</th>
						<th scope="col" class="py-2 pr-3 font-semibold">Resultado</th>
						<th scope="col" class="py-2 font-semibold">Detalle</th>
					</tr>
				</thead>
				<tbody>
					for _, r := range v.Results {
						<tr class="border-t border-line align-top">
							<td class="py-2 pr-3">{ checkDescription(e.Snapshot, r.Check) }</td>
							<td class="py-2 pr-3">
								if r.Passed {
									<span class="text-success">Pasa</span>
								} else {
									<span class="text-danger">No pasa</span>
								}
							</td>
							<td class="py-2 font-mono text-[13px] break-all text-muted">{ r.Detail }</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
		<p class={ hintCls }>Tarball: <span class="font-mono break-all">{ v.Archive }</span></p>
	}
}

// challengeBody es el enunciado, con la estructura del mockup Retos: cabecera, requisitos, DoD, entregables y checks.
templ challengeBody(c retos.Challenge) {
	<div class="rounded-lg bg-ink p-6 text-bg">
		<p class="flex flex-wrap gap-2 font-mono text-[13px]">
			<span>{ c.Level.String() }</span>
			if c.EstimatedDuration != "" {
				<span aria-hidden="true">·</span>
				<span>{ c.EstimatedDuration }</span>
			}
			<span aria-hidden="true">·</span>
			<span>{ reviewLabel(c) }</span>
		</p>
		<p class="mt-3 text-[17px] leading-relaxed">{ c.Context }</p>
		if len(c.Stack) > 0 {
			<ul class="mt-4 flex flex-wrap gap-1.5" aria-label="Stack">
				for _, s := range c.Stack {
					<li class="rounded-sm border border-current px-2 py-0.5 font-mono text-[13px]">{ s }</li>
				}
			</ul>
		}
	</div>
	<section class={ card, "flex flex-col gap-3" } aria-label="Habilidades">
		<h2 class="text-base font-semibold">Habilidades y nivel</h2>
		<ul class="flex flex-col gap-1 text-sm">
			for _, s := range c.Skills {
				<li>{ skillName(s.Skill) }: { s.Level.String() }</li>
			}
		</ul>
	</section>
	<div class="grid gap-4 sm:grid-cols-2">
		<section class={ card } aria-label="Requisitos técnicos">
			<h2 class="mb-3 text-base font-semibold">Requisitos técnicos</h2>
			<ul class="list-disc pl-5 text-[15px] leading-relaxed">
				for _, q := range c.Requirements {
					<li>{ q }</li>
				}
			</ul>
			if len(c.Constraints) > 0 {
				<h3 class="mt-4 mb-2 text-sm font-semibold text-muted">Restricciones</h3>
				<ul class="list-disc pl-5 text-sm leading-relaxed text-muted">
					for _, q := range c.Constraints {
						<li>{ q }</li>
					}
				</ul>
			}
		</section>
		<section class={ card } aria-label="Definition of Done">
			<h2 class="mb-3 text-base font-semibold">Definition of Done</h2>
			<ul class="list-disc pl-5 text-[15px] leading-relaxed">
				for _, q := range c.DefinitionOfDone {
					<li>{ q }</li>
				}
			</ul>
			if len(c.Deliverables) > 0 {
				<h3 class="mt-4 mb-2 text-sm font-semibold text-muted">Entregables</h3>
				<ul class="list-disc pl-5 text-sm leading-relaxed text-muted">
					for _, q := range c.Deliverables {
						<li>{ q }</li>
					}
				</ul>
			}
		</section>
	</div>
	<section class={ card, "flex flex-col gap-3" } aria-label="Checks reproducibles">
		<h2 class="text-base font-semibold">Checks reproducibles</h2>
		<p class="text-sm text-muted">Gremio baja el repo en el commit entregado y comprueba su estructura y su contenido, sin ejecutar su código. Cualquiera puede repetirlos.</p>
		<ul class="flex flex-col gap-1.5 text-sm">
			for _, ch := range c.Checks {
				<li>
					{ ch.Description }
					<span class="font-mono text-[13px] break-all text-faint">{ ch.Kind } { ch.Path }</span>
				</li>
			}
		</ul>
	</section>
	<p class={ hintCls }>
		Propuesto por { c.Author }
		if c.Origin == "ai" {
			(borrador generado con { c.Model })
		}
		· licencia { c.License }
	</p>
}

templ PublicChallengePage(p Page, slug string, c retos.Challenge, latest int) {
	@layout(p, c.Title+" · Dojo") {
		<article class="mx-auto flex max-w-[960px] flex-col gap-6 px-4 py-10 sm:px-6">
			<header>
				<p class={ eyebrow }>Reto del dojo · { slug } · v{ itoa(c.Version) }</p>
				<h1 class="mt-2 font-display text-[34px] leading-tight font-bold">{ c.Title }</h1>
				<p class="mt-2 text-[17px] text-muted">{ c.Pitch }</p>
				if c.Version < latest {
					<p class="mt-3 text-sm">Hay una versión más nueva: <a href={ templ.SafeURL("/dojo/catalogo/" + slug) }>v{ itoa(latest) }</a>.</p>
				}
			</header>
			@challengeBody(c)
		</article>
	}
}

templ PublicExecutionPage(p Page, e retos.Execution, trust dojo.Trust) {
	@layout(p, e.Snapshot.Title+" · Ejecución") {
		<article class="mx-auto flex max-w-[960px] flex-col gap-6 px-4 py-10 sm:px-6">
			<header>
				<p class={ eyebrow }>Ejecución de un reto · { p.Handle }</p>
				<h1 class="mt-2 font-display text-[34px] leading-tight font-bold">{ e.Snapshot.Title }</h1>
				<p class="mt-3 flex flex-wrap gap-1.5">
					<span class={ dataChip }>{ e.Snapshot.Level.String() }</span>
					<span class={ dataChip }>{ statusLabel(e) }</span>
					if trust != "" {
						<span class={ dataChip }>{ trustLabel(trust) }</span>
					}
				</p>
				<p class="mt-3 text-sm text-muted">
					Empezada el { e.StartedAt.Format("2006-01-02") }
					if !e.CompletedAt.IsZero() {
						· terminada el { e.CompletedAt.Format("2006-01-02") }
					}
					· <a href={ templ.SafeURL(challengePath(e)) }>enunciado v{ itoa(e.Version) }</a>
				</p>
			</header>
			<section class={ card, "flex flex-col gap-3" } aria-label="Entrega">
				<h2 class="text-base font-semibold">Entrega</h2>
				<dl class="grid gap-x-4 gap-y-1 text-sm sm:grid-cols-[auto_1fr]">
					if e.Delivery.Repo != "" {
						<dt class="text-muted">Repositorio</dt>
						<dd><a class="break-all" rel="noopener" href={ templ.SafeURL(e.Delivery.Repo) }>{ e.Delivery.Repo }</a></dd>
						<dt class="text-muted">Commit</dt>
						<dd class="font-mono break-all">{ e.Delivery.Commit }</dd>
					}
					if e.Delivery.Demo != "" {
						<dt class="text-muted">Demo</dt>
						<dd><a class="break-all" rel="noopener" href={ templ.SafeURL(e.Delivery.Demo) }>{ e.Delivery.Demo }</a></dd>
					}
					if e.Delivery.Report != "" {
						<dt class="text-muted">Informe</dt>
						<dd><a class="break-all" rel="noopener" href={ templ.SafeURL(e.Delivery.Report) }>{ e.Delivery.Report }</a></dd>
					}
				</dl>
			</section>
			<section id="verificacion" class={ card, "flex flex-col gap-4" } aria-labelledby="verificacion-titulo">
				<h2 id="verificacion-titulo" class="text-base font-semibold">Verificación</h2>
				@verification(e)
			</section>
		</article>
	}
}

func execAction(e retos.Execution, action string) string {
	return "/panel/dojo/ejecuciones/" + e.ID + "/" + action
}

func challengePath(e retos.Execution) string {
	if slug, ok := e.Slug(); ok {
		return "/dojo/catalogo/" + slug + "/v" + strconv.Itoa(e.Version)
	}
	return e.Challenge
}

func statusLabel(e retos.Execution) string {
	switch e.Status {
	case retos.StatusDone:
		return "Terminada"
	case retos.StatusAbandoned:
		return "Abandonada"
	}
	return "En curso"
}

func reviewLabel(c retos.Challenge) string {
	if c.Reviewed() {
		return "Revisado por " + c.Reviewer
	}
	return "En revisión: cuenta como práctica propia (N2 como máximo)"
}

func skillName(id string) string {
	if s, ok := dojo.FindSkill(id); ok {
		return s.Name
	}
	return id
}

func skillNames(list []dojo.SkillLevel) string {
	out := ""
	for i, s := range list {
		if i > 0 {
			out += " · "
		}
		out += skillName(s.Skill)
	}
	return out
}

func checkDescription(c retos.Challenge, id string) string {
	for _, ch := range c.Checks {
		if ch.ID == id {
			return ch.Description
		}
	}
	return id
}

// shown redondea como la ficha: half away from zero, solo al mostrar (ADR-013 §6).
func shown(v float64) string { return strconv.Itoa(int(math.Round(v))) }
