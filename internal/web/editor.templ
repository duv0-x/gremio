package web

import (
	"slices"
	"strconv"

	"github.com/duv0-x/gremio/internal/profile"
)

const (
	inputCls = "min-h-11 w-full rounded-md border border-control bg-surface-2 px-3 text-ink"
	labelCls = "text-sm font-semibold"
	hintCls  = "text-[13px] text-faint"
)

type option struct{ Value, Label string }

// editorLayout es una página del editor: volver al panel, título, resultado del último guardado y el formulario.
templ editorLayout(e editPage, title string) {
	@panelLayout(e.Version, title) {
		<div>
			<a href="/panel" class="inline-flex min-h-11 items-center font-mono text-[13px] text-muted no-underline hover:text-ink">‹ Panel</a>
			<h1 class="mt-1 font-display text-[28px] font-bold">{ title }</h1>
		</div>
		if e.Notice != "" {
			<p role="status" class="rounded-md border border-success p-4 text-sm text-ink">{ e.Notice }</p>
		}
		if e.Error != "" {
			<p role="alert" class="rounded-md border border-danger p-4 text-sm text-ink">{ e.Error }</p>
		}
		<form method="post" action={ templ.SafeURL(e.Path) } class="flex flex-col gap-6">
			{ children... }
			<div class="sticky bottom-0 -mx-4 flex gap-3 border-t border-line bg-bg px-4 py-3">
				<button type="submit" class={ btnPrimary, "flex-1 sm:flex-none" }>Guardar</button>
				<a class={ btnSec, "flex-1 sm:flex-none" } href="/panel">Cancelar</a>
			</div>
		</form>
	}
}

templ fieldset(legend string) {
	<fieldset class={ card, "flex min-w-0 flex-col gap-4" }>
		<legend class="float-left mb-2 w-full font-display text-xl font-bold">{ legend }</legend>
		{ children... }
	</fieldset>
}

templ textField(label, name, value, hint string) {
	<div class="flex flex-col gap-1.5">
		<label for={ name } class={ labelCls }>{ label }</label>
		<input id={ name } name={ name } type="text" value={ value } class={ inputCls } aria-describedby={ hintID(name, hint) }/>
		@fieldHint(name, hint)
	</div>
}

templ textArea(label, name, value, hint string, rows int) {
	<div class="flex flex-col gap-1.5">
		<label for={ name } class={ labelCls }>{ label }</label>
		<textarea id={ name } name={ name } rows={ strconv.Itoa(rows) } class={ inputCls, "py-2 leading-relaxed" } aria-describedby={ hintID(name, hint) }>{ value }</textarea>
		@fieldHint(name, hint)
	</div>
}

templ selectField(label, name, value string, opts []option) {
	<div class="flex flex-col gap-1.5">
		<label for={ name } class={ labelCls }>{ label }</label>
		<select id={ name } name={ name } class={ inputCls }>
			for _, o := range opts {
				<option value={ o.Value } selected?={ o.Value == value }>{ o.Label }</option>
			}
		</select>
	</div>
}

templ checkField(label, name string, on bool) {
	<label class="flex min-h-11 items-center gap-3 text-sm">
		<input type="checkbox" name={ name } value="1" checked?={ on } class="size-5 accent-accent"/>
		{ label }
	</label>
}

templ fieldHint(name, hint string) {
	if hint != "" {
		<p id={ name + "-ayuda" } class={ hintCls }>{ hint }</p>
	}
}

// rowControls son el orden y la casilla de borrar de una fila de lista; las filas nuevas no tienen qué borrar.
templ rowControls(prefix string, i int, isNew bool) {
	<div class="flex flex-wrap items-end gap-4">
		<div class="flex w-24 flex-col gap-1.5">
			<label for={ field(prefix, i, "orden") } class={ labelCls }>Orden</label>
			<input id={ field(prefix, i, "orden") } name={ field(prefix, i, "orden") } type="number" step="any" value={ strconv.Itoa(i + 1) } class={ inputCls }/>
		</div>
		if !isNew {
			@checkField("Borrar", field(prefix, i, "borrar"), false)
		}
	</div>
}

templ rowBox(i, n int) {
	<div class={ "flex flex-col gap-4 rounded-md border p-4", templ.KV("border-line", i < n), templ.KV("border-dashed border-control", i >= n) }>
		if i >= n {
			<p class={ eyebrow }>Nuevo</p>
		}
		{ children... }
	</div>
}

templ BasicsForm(e editPage) {
	@editorLayout(e, "Básico y contacto") {
		@fieldset("Identidad") {
			@textField("Nombre", "name", e.R.Basics.Name, "")
			@textField("Título", "label", e.R.Basics.Label, "Lo que va junto al nombre, p. ej. Senior Platform Engineer.")
			@textArea("Bio corta", "summary", e.R.Basics.Summary, "La muestran Mastodon y las demás instancias.", 3)
			@textArea("Presentación", "about", e.R.Gremio.About, "El texto largo de la ficha. Si queda vacío se usa la bio.", 6)
			@textField("Sitio web", "url", e.R.Basics.URL, "")
		}
		@fieldset("Ubicación") {
			<div class="grid gap-4 sm:grid-cols-3">
				@textField("Ciudad", "city", loc(e.R).City, "")
				@textField("Región", "region", loc(e.R).Region, "")
				@textField("País", "country", loc(e.R).CountryCode, "Código ISO, p. ej. CO.")
			</div>
			@textField("Zona horaria", "timezone", e.R.Gremio.Timezone, "Nombre IANA, p. ej. America/Bogota.")
		}
		@fieldset("Contacto") {
			<p class="text-sm text-muted">El correo y el teléfono son privados salvo que los marques. WhatsApp publica el teléfono solo como enlace, nunca como texto.</p>
			@textField("Correo", "email", e.R.Basics.Email, "")
			@checkField("Mostrar el correo en el perfil", "email_publico", e.R.Gremio.Contact.Email == "public")
			@textField("Teléfono", "phone", e.R.Basics.Phone, "Con indicativo, p. ej. +57 300 000 0000.")
			@checkField("Mostrar el teléfono en el perfil", "telefono_publico", e.R.Gremio.Contact.Phone == "public")
			@checkField("Botón de WhatsApp con este teléfono", "whatsapp_publico", e.R.Gremio.Contact.Whatsapp == "public")
		}
		@fieldset("Redes") {
			for i := range pad(len(e.R.Basics.Profiles)) {
				@rowBox(i, len(e.R.Basics.Profiles)) {
					<div class="grid gap-4 sm:grid-cols-3">
						@textField("Red", field("red", i, "network"), social(e.R, i).Network, "")
						@textField("Usuario", field("red", i, "username"), social(e.R, i).Username, "")
						@textField("URL", field("red", i, "url"), social(e.R, i).URL, "")
					</div>
					@rowControls("red", i, i >= len(e.R.Basics.Profiles))
				}
			}
		}
	}
}

func hintID(name, hint string) string {
	if hint == "" {
		return ""
	}
	return name + "-ayuda"
}

func loc(r *profile.Resume) profile.Location {
	if r.Basics.Location == nil {
		return profile.Location{}
	}
	return *r.Basics.Location
}

func social(r *profile.Resume, i int) profile.Social {
	if i < len(r.Basics.Profiles) {
		return r.Basics.Profiles[i]
	}
	return profile.Social{}
}

// itemLink es el enlace a la página de un elemento de una lista, o para agregar uno.
templ itemLink(href, label string) {
	<a href={ templ.SafeURL(href) } class={ btnSec, "self-start" }>{ label }</a>
}

templ WorkListForm(e editPage) {
	@editorLayout(e, "Experiencia") {
		@itemLink("/panel/experiencia/nuevo", "Agregar trabajo")
		@fieldset("Trabajos") {
			<p class="text-sm text-muted">El primero sin fecha de fin es el trabajo actual. Cambia el orden o marca Borrar y guarda; los datos y los logros de cada trabajo se editan en su página.</p>
			if len(e.R.Work) == 0 {
				<p class="text-sm text-faint">Todavía no hay trabajos.</p>
			}
			for i, w := range e.R.Work {
				@rowBox(i, len(e.R.Work)) {
					<input type="hidden" name={ field("trabajo", i, "id") } value={ w.ID }/>
					<div class="flex flex-wrap items-start justify-between gap-3">
						<div>
							<p class="font-display text-lg font-semibold">{ w.Name }</p>
							<p class="text-sm text-muted">
								{ w.Position }
								if w.Position != "" {
									·
								}
								{ dateRange(w.StartDate, w.EndDate) } · { itoa(len(w.Highlights)) } { plural(len(w.Highlights), "logro", "logros") }
							</p>
						</div>
						@itemLink("/panel/experiencia/"+w.ID, "Editar")
					</div>
					@rowControls("trabajo", i, false)
				}
			}
		}
	}
}

templ WorkForm(e editPage) {
	@editorLayout(e, workTitle(e)) {
		@fieldset("Trabajo") {
			@textField("Empresa u organización", "name", work(e).Name, "")
			@textField("Cargo", "position", work(e).Position, "")
			<div class="grid gap-4 sm:grid-cols-2">
				@textField("Inicio", "start", work(e).StartDate, "AAAA-MM, p. ej. 2021-05.")
				@textField("Fin", "end", work(e).EndDate, "Vacío si es el trabajo actual.")
			</div>
			@textField("Ubicación", "location", work(e).Location, "")
			@textField("Sitio web", "url", work(e).URL, "")
			@textArea("Resumen", "summary", work(e).Summary, "", 3)
		}
		@fieldset("Logros") {
			<p class="text-sm text-muted">Un logro por recuadro. La evidencia son enlaces que lo respaldan (charlas, repos, artículos), uno por línea.</p>
			for i := range pad(len(work(e).Highlights)) {
				@rowBox(i, len(work(e).Highlights)) {
					if i < len(work(e).Highlights) {
						<input type="hidden" name={ field("logro", i, "id") } value={ work(e).Highlights[i].ID }/>
					}
					@textArea("Logro", field("logro", i, "text"), highlight(e, i).Text, "", 4)
					@textArea("Evidencia", field("logro", i, "evidence"), joinLines(highlight(e, i).Evidence), "", 2)
					@rowControls("logro", i, i >= len(work(e).Highlights))
				}
			}
		}
	}
}

// hiddenID guarda el id de una fila que ya existe, para no romper las referencias de vistas y atributos.
templ hiddenID(prefix string, i int, id string) {
	if id != "" {
		<input type="hidden" name={ field(prefix, i, "id") } value={ id }/>
	}
}

templ SkillsForm(e editPage) {
	@editorLayout(e, "Skills") {
		@fieldset("Skills") {
			<p class="text-sm text-muted">Las palabras clave van separadas por comas. La evidencia son enlaces, uno por línea.</p>
			for i := range pad(len(e.R.Skills)) {
				@rowBox(i, len(e.R.Skills)) {
					@hiddenID("skill", i, at(e.R.Skills, i).ID)
					<div class="grid gap-4 sm:grid-cols-2">
						@textField("Nombre", field("skill", i, "name"), at(e.R.Skills, i).Name, "")
						@selectField("Nivel", field("skill", i, "level"), at(e.R.Skills, i).Level, skillLevels)
					</div>
					@textArea("Palabras clave", field("skill", i, "keywords"), joinComma(at(e.R.Skills, i).Keywords), "", 2)
					@textArea("Evidencia", field("skill", i, "evidence"), joinLines(at(e.R.Skills, i).Evidence), "", 2)
					@rowControls("skill", i, i >= len(e.R.Skills))
				}
			}
		}
	}
}

templ ProjectsForm(e editPage) {
	@editorLayout(e, "Proyectos") {
		@fieldset("Proyectos") {
			<p class="text-sm text-muted">Se muestran en la pestaña Proyectos. El stack va separado por comas; la captura es la URL de una imagen.</p>
			for i := range pad(len(e.R.Projects)) {
				@rowBox(i, len(e.R.Projects)) {
					@hiddenID("proyecto", i, at(e.R.Projects, i).ID)
					@textField("Nombre", field("proyecto", i, "name"), at(e.R.Projects, i).Name, "")
					@textArea("Descripción", field("proyecto", i, "description"), at(e.R.Projects, i).Description, "", 3)
					<div class="grid gap-4 sm:grid-cols-2">
						@textField("URL", field("proyecto", i, "url"), at(e.R.Projects, i).URL, "")
						@textField("Captura", field("proyecto", i, "image"), at(e.R.Projects, i).Image, "")
					</div>
					@textField("Stack", field("proyecto", i, "keywords"), joinComma(at(e.R.Projects, i).Keywords), "")
					@rowControls("proyecto", i, i >= len(e.R.Projects))
				}
			}
		}
	}
}

templ FormationForm(e editPage) {
	@editorLayout(e, "Educación, idiomas y certificados") {
		@fieldset("Educación") {
			for i := range pad(len(e.R.Education)) {
				@rowBox(i, len(e.R.Education)) {
					@hiddenID("estudio", i, at(e.R.Education, i).ID)
					@textField("Institución", field("estudio", i, "institution"), at(e.R.Education, i).Institution, "")
					<div class="grid gap-4 sm:grid-cols-2">
						@textField("Título o tipo", field("estudio", i, "studyType"), at(e.R.Education, i).StudyType, "p. ej. Ingeniería, Maestría.")
						@textField("Área", field("estudio", i, "area"), at(e.R.Education, i).Area, "")
						@textField("Inicio", field("estudio", i, "start"), at(e.R.Education, i).StartDate, "AAAA o AAAA-MM.")
						@textField("Fin", field("estudio", i, "end"), at(e.R.Education, i).EndDate, "")
					</div>
					@rowControls("estudio", i, i >= len(e.R.Education))
				}
			}
		}
		@fieldset("Idiomas") {
			for i := range pad(len(e.R.Languages)) {
				@rowBox(i, len(e.R.Languages)) {
					<div class="grid gap-4 sm:grid-cols-2">
						@textField("Idioma", field("idioma", i, "language"), at(e.R.Languages, i).Language, "")
						@textField("Nivel", field("idioma", i, "fluency"), at(e.R.Languages, i).Fluency, "p. ej. Nativo, B2.")
					</div>
					@rowControls("idioma", i, i >= len(e.R.Languages))
				}
			}
		}
		@fieldset("Certificados") {
			for i := range pad(len(e.R.Certificates)) {
				@rowBox(i, len(e.R.Certificates)) {
					@textField("Nombre", field("certificado", i, "name"), at(e.R.Certificates, i).Name, "")
					<div class="grid gap-4 sm:grid-cols-2">
						@textField("Emisor", field("certificado", i, "issuer"), at(e.R.Certificates, i).Issuer, "")
						@textField("Fecha", field("certificado", i, "date"), at(e.R.Certificates, i).Date, "AAAA-MM.")
					</div>
					@textField("URL", field("certificado", i, "url"), at(e.R.Certificates, i).URL, "")
					@rowControls("certificado", i, i >= len(e.R.Certificates))
				}
			}
		}
	}
}

// checkList es un grupo de casillas con el mismo name, una por opción.
templ checkList(name string, opts []option, selected []string) {
	<div class="grid gap-x-4 sm:grid-cols-2">
		for _, o := range opts {
			<label class="flex min-h-11 items-start gap-3 py-2 text-sm">
				<input type="checkbox" name={ name } value={ o.Value } checked?={ slices.Contains(selected, o.Value) } class="mt-0.5 size-5 shrink-0 accent-accent"/>
				<span>{ o.Label }</span>
			</label>
		}
	</div>
}

// listItem es una fila de las listas de vistas y atributos: título, detalle, Editar, orden y borrar.
templ listItem(prefix string, i, n int, id, title, detail, href string) {
	@rowBox(i, n) {
		<input type="hidden" name={ field(prefix, i, "id") } value={ id }/>
		<div class="flex flex-wrap items-start justify-between gap-3">
			<div>
				<p class="font-display text-lg font-semibold">{ title }</p>
				<p class="text-sm text-muted">{ detail }</p>
			</div>
			@itemLink(href, "Editar")
		</div>
		@rowControls(prefix, i, false)
	}
}

templ ViewListForm(e editPage) {
	@editorLayout(e, "Vistas por rol") {
		@itemLink("/panel/vistas/nuevo", "Agregar vista")
		@fieldset("Vistas") {
			<p class="text-sm text-muted">La primera es la principal: la que abre /@usuario y lleva la marca de rol actual.</p>
			for i, v := range e.R.Gremio.Views {
				@listItem("vista", i, len(e.R.Gremio.Views), v.Slug, v.Name, v.Code+" · /"+v.Slug+" · OVR "+itoa(e.R.Overall(v)), "/panel/vistas/"+v.Slug)
			}
		}
	}
}

templ ViewForm(e editPage) {
	@editorLayout(e, titleOr(view(e).Name, "Nueva vista")) {
		@fieldset("Vista") {
			@textField("Nombre", "name", view(e).Name, "p. ej. Platform Engineer.")
			<div class="grid gap-4 sm:grid-cols-3">
				<div class="flex flex-col gap-1.5">
					<label for="code" class={ labelCls }>Posición</label>
					<input id="code" name="code" type="text" list="posiciones" value={ view(e).Code } class={ inputCls } aria-describedby="code-ayuda"/>
					<p id="code-ayuda" class={ hintCls }>Código del catálogo, p. ej. PLE.</p>
					<datalist id="posiciones">
						for _, pos := range profile.Positions {
							<option value={ pos.Code }>{ pos.Name }</option>
						}
					</datalist>
				</div>
				@selectField("Nivel", "level", view(e).Level, viewLevels)
				@textField("Slug", "slug", view(e).Slug, "La URL: /@usuario/<slug>.")
			</div>
			@textArea("Resumen", "summary", view(e).Summary, "", 3)
		}
		@fieldset("Pesos") {
			<p class="text-sm text-muted">Cuánto pesa cada atributo en el OVR de esta vista. Vacío o 0 lo excluye; si todos quedan vacíos, todos pesan igual.</p>
			<div class="grid items-end gap-4 sm:grid-cols-3">
				for _, a := range e.R.Gremio.Attributes {
					<div class="flex flex-col gap-1.5">
						<label for={ "peso." + a.Code } class={ labelCls }>{ a.Code } · { a.Name }</label>
						<input id={ "peso." + a.Code } name={ "peso." + a.Code } type="number" step="any" min="0" value={ weightValue(view(e), a.Code) } class={ inputCls }/>
					</div>
				}
			</div>
		}
		@fieldset("Qué incluye") {
			<p class="text-sm text-muted">Los trabajos, logros y skills que destaca esta vista.</p>
			<h3 class={ eyebrow }>Trabajos</h3>
			@checkList("work", workOptions(e.R), view(e).Work)
			<h3 class={ eyebrow }>Logros</h3>
			@checkList("highlight", highlightOptions(e.R), view(e).Highlights)
			<h3 class={ eyebrow }>Skills</h3>
			@checkList("skill", skillOptions(e.R), view(e).Skills)
		}
	}
}

templ AttributeListForm(e editPage) {
	@editorLayout(e, "Atributos de la ficha") {
		@itemLink("/panel/atributos/nuevo", "Agregar atributo")
		@fieldset("Atributos") {
			<p class="text-sm text-muted">Los ejes del radar: hacen falta al menos 3. Borrar uno lo quita también de los pesos de las vistas.</p>
			for i, a := range e.R.Gremio.Attributes {
				@listItem("atributo", i, len(e.R.Gremio.Attributes), a.Code, a.Code+" · "+a.Name, "Puntaje "+itoa(a.Score())+" · "+itoa(len(a.Subs))+" sub-atributos", "/panel/atributos/"+a.Code)
			}
		}
	}
}

templ AttributeForm(e editPage) {
	@editorLayout(e, titleOr(attribute(e).Name, "Nuevo atributo")) {
		@fieldset("Atributo") {
			<div class="grid gap-4 sm:grid-cols-3">
				@textField("Código", "code", attribute(e).Code, "2 a 4 letras, p. ej. IAC.")
				<div class="sm:col-span-2">
					@textField("Nombre", "name", attribute(e).Name, "")
				</div>
			</div>
		}
		@fieldset("Sub-atributos") {
			<p class="text-sm text-muted">El puntaje del atributo es el promedio de estos, de 0 a 99.</p>
			for i := range pad(len(attribute(e).Subs)) {
				@rowBox(i, len(attribute(e).Subs)) {
					<div class="grid gap-4 sm:grid-cols-3">
						<div class="sm:col-span-2">
							@textField("Nombre", field("sub", i, "name"), at(attribute(e).Subs, i).Name, "")
						</div>
						<div class="flex flex-col gap-1.5">
							<label for={ field("sub", i, "score") } class={ labelCls }>Puntaje</label>
							<input id={ field("sub", i, "score") } name={ field("sub", i, "score") } type="number" min="0" max="99" value={ scoreValue(at(attribute(e).Subs, i), i >= len(attribute(e).Subs)) } class={ inputCls }/>
						</div>
					</div>
					@checkField("Lo estoy aprendiendo", field("sub", i, "learning"), at(attribute(e).Subs, i).Learning)
					@rowControls("sub", i, i >= len(attribute(e).Subs))
				}
			}
		}
		@fieldset("Lo respaldan") {
			<h3 class={ eyebrow }>Skills</h3>
			@checkList("skill", skillOptions(e.R), attribute(e).Skills)
			<h3 class={ eyebrow }>Logros</h3>
			@checkList("highlight", highlightOptions(e.R), attribute(e).Highlights)
		}
	}
}

templ TraitsForm(e editPage) {
	@editorLayout(e, "Rasgos") {
		@fieldset("Rasgos") {
			<p class="text-sm text-muted">Insignias de la ficha. El ícono es un nombre de lucide.dev/icons, p. ej. bot.</p>
			for i := range pad(len(e.R.Gremio.Traits)) {
				@rowBox(i, len(e.R.Gremio.Traits)) {
					@textField("Nombre", field("rasgo", i, "name"), at(e.R.Gremio.Traits, i).Name, "")
					@textArea("Descripción", field("rasgo", i, "summary"), at(e.R.Gremio.Traits, i).Summary, "", 2)
					<div class="grid gap-4 sm:grid-cols-2">
						@textField("Ícono", field("rasgo", i, "icon"), at(e.R.Gremio.Traits, i).Icon, "")
						@selectField("Color", field("rasgo", i, "color"), at(e.R.Gremio.Traits, i).Color, traitColors)
					</div>
					@rowControls("rasgo", i, i >= len(e.R.Gremio.Traits))
				}
			}
		}
	}
}
